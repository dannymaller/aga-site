# Code and markup must revalidate, or a fix can sit invisible for a day while
# browsers serve a cached copy. Revalidation is cheap: unchanged files come
# back as a 304 with no body.

/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Images and the font never change without changing name, so they can sit.
/assets/*.png
  Cache-Control: public, max-age=604800

/assets/*.jpg
  Cache-Control: public, max-age=604800

/assets/american-typewriter.woff2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/assets/leaflet/*
  Cache-Control: public, max-age=604800
